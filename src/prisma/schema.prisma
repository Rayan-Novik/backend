  quantidade    Decimal       @db.Decimal(10, 3)
  id_usuario    Int?
  data_producao DateTime?     @default(now()) @db.Timestamp(0)
  produtos      produtos      @relation(fields: [id_produto], references: [id_produto], onDelete: NoAction, onUpdate: NoAction, map: "fk_op_produto")
  funcionarios  funcionarios? @relation(fields: [id_usuario], references: [id_funcionario], onDelete: NoAction, onUpdate: NoAction, map: "fk_op_funcionario")

  @@index([id_produto], map: "fk_op_produto")
  @@index([id_usuario], map: "fk_op_funcionario")
}

model produto_composicao {
  id_composicao         Int      @id @default(autoincrement())
  id_produto_final      Int
  id_insumo             Int
  quantidade_necessaria Decimal  @db.Decimal(10, 3)
  insumo                produtos @relation("RelacaoInsumo", fields: [id_insumo], references: [id_produto], onDelete: Cascade, map: "fk_composicao_insumo")
  produto_final         produtos @relation("RelacaoProdutoFinal", fields: [id_produto_final], references: [id_produto], onDelete: Cascade, map: "fk_composicao_produto_final")

