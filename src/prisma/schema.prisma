  // 🟢 Configurações do Motor de IA
  provedor_ia             String   @default("GROQ") @db.VarChar(50) 
  groq_api_key            String?
  gemini_api_key          String?
  deepseek_api_key        String?
  
  // Status e Comportamento Macro
  ia_ativada              Boolean  @default(true)
  ia_auto_atendimento     Boolean  @default(false)
  modo_apenas_agendamento Boolean  @default(false) // 🟢 Ativa a IA Recepcionista
  
  // Personalização do Agente
  nome_agente             String   @default("Chico") @db.VarChar(100)
  personalidade           String   @default("Neutro e Direto") @db.VarChar(100)
  ramo_loja               String   @default("Restaurante / Lanches") @db.VarChar(150)
  
  // Comportamento Micro
  tempo_resposta          Int      @default(3) // Tempo de delay em segundos
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relacionamento com a tabela tenants
  tenants                 tenants  @relation(fields: [id_tenant], references: [id], onDelete: Cascade)

  @@index([id_tenant], map: "idx_aiconfig_tenant")
}

model configuracoes_fiscais {
  id_config           Int      @id @default(autoincrement())
  id_tenant           Int      @unique
  
