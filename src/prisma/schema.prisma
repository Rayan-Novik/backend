  cnpj                String?  @db.VarChar(14)
  razao_social        String?  @db.VarChar(255)
  inscricao_estadual  String?  @db.VarChar(50)
  inscricao_municipal String?  @db.VarChar(50)
  regime_tributario   String?  @default("SIMPLES_NACIONAL") @db.VarChar(50) 
  
  // Configurações de Emissão
  ambiente            String   @default("HOMOLOGACAO") @db.VarChar(20) // HOMOLOGACAO ou PRODUCAO
  
  // Contadores para SEFAZ (Produtos)
  serie_nfe           Int      @default(1)
  serie_nfce          Int      @default(1)
  serie_nfae          Int      @default(1)
  proximo_numero_nfe  Int      @default(1)
  proximo_numero_nfce Int      @default(1)
  proximo_numero_nfae Int      @default(1)

  // Contadores para Prefeitura (Serviços - NFS-e)
  serie_rps           String   @default("1") @db.VarChar(10) // RPS geralmente aceita letras
  proximo_numero_rps  Int      @default(1)
  codigo_municipio    String?  @db.VarChar(10) // Código IBGE da cidade para a NFS-e
  
  // Certificado Digital (A1)
  certificado_base64  String?  @db.LongText // Armazena o .pfx em base64 (ou mude para URL se usar bucket)
  senha_certificado   String?  @db.VarChar(255)
  vencimento_cert     DateTime? @db.Date

  atualizado_em       DateTime @updatedAt

  tenants             tenants  @relation(fields: [id_tenant], references: [id], onDelete: Cascade)
}

enum nota_fiscal_operacao {
  ENTRADA
  SAIDA
}

model notas_fiscais {
  id_nota         Int      @id @default(autoincrement())
  id_tenant       Int
  id_pedido       Int?     @unique // Pode ser nulo se for nota de ENTRADA
  id_fornecedor   Int?     // Vínculo com fornecedor para notas de ENTRADA
  
  tipo_operacao   nota_fiscal_operacao @default(SAIDA) // Entrada ou Saída
  tipo_nota       String   @db.VarChar(10) // NFE, NFCE, NFSE, NFAE
  numero_nota     Int?
  serie           Int?
  chave_acesso    String?  @unique @db.VarChar(50) 
  
  status          String   @default("RASCUNHO") @db.VarChar(50) 
  motivo_status   String?  @db.VarChar(255) 
  
  xml_gerado      String?  @db.LongText
  protocolo_sefaz String?  @db.VarChar(100)
  url_danfe       String?  @db.VarChar(2048) 
  
  // 🟢 VALORES COMPOSITIVOS DA NOTA E TOTAIS
  valor_produtos  Decimal  @default(0.00) @db.Decimal(10, 2)
  valor_frete     Decimal  @default(0.00) @db.Decimal(10, 2)
  valor_seguro    Decimal  @default(0.00) @db.Decimal(10, 2)
  valor_desconto  Decimal  @default(0.00) @db.Decimal(10, 2)
  valor_total     Decimal  @db.Decimal(10, 2) // Soma de tudo
  
  total_icms      Decimal? @default(0.00) @db.Decimal(10, 2)
  total_pis       Decimal? @default(0.00) @db.Decimal(10, 2)
  total_cofins    Decimal? @default(0.00) @db.Decimal(10, 2)
  total_ipi       Decimal? @default(0.00) @db.Decimal(10, 2)
  total_iss       Decimal? @default(0.00) @db.Decimal(10, 2)
  total_tributos  Json?    // Guarda total de IBS, CBS e FCP para a nova reforma

  data_emissao    DateTime @default(now()) @db.Timestamp(0)
  atualizado_em   DateTime @updatedAt

  // RELACIONAMENTOS
  tenants         tenants        @relation(fields: [id_tenant], references: [id], onDelete: Cascade)
  pedidos         pedidos?       @relation(fields: [id_pedido], references: [id_pedido], onDelete: SetNull)
  fornecedores    fornecedores?  @relation(fields: [id_fornecedor], references: [id_fornecedor], onDelete: SetNull)
  itens           nota_fiscal_itens[]

  @@index([id_tenant], map: "idx_nf_tenant")
  @@index([id_pedido], map: "idx_nf_pedido")
  @@index([chave_acesso], map: "idx_nf_chave")
  @@index([id_fornecedor], map: "idx_nf_fornecedor")
}

model nota_fiscal_itens {
  id_item         Int      @id @default(autoincrement())
  id_nota         Int
  id_produto      Int?     // Opcional, caso o produto ainda não exista no sistema ao importar o XML
  nome_produto    String   @db.VarChar(255)
  quantidade      Decimal  @db.Decimal(10, 3)
  valor_unitario  Decimal  @db.Decimal(10, 2)
  valor_total     Decimal  @db.Decimal(10, 2)
  
  // 🟢 DADOS FISCAIS ESTÁTICOS NO MOMENTO DA EMISSÃO
  cfop            String?  @db.VarChar(10)
  ncm             String?  @db.VarChar(20)
  cest            String?  @db.VarChar(10)
  cst_icms        String?  @db.VarChar(4)
  cst_pis_cofins  String?  @db.VarChar(4)

  // 🟢 IMPOSTOS CALCULADOS DO ITEM E REFORMA TRIBUTÁRIA
  base_icms       Decimal? @default(0.00) @db.Decimal(10, 2)
  valor_icms      Decimal? @default(0.00) @db.Decimal(10, 2)
  valor_pis       Decimal? @default(0.00) @db.Decimal(10, 2)
  valor_cofins    Decimal? @default(0.00) @db.Decimal(10, 2)
  valor_ipi       Decimal? @default(0.00) @db.Decimal(10, 2)
  valor_iss       Decimal? @default(0.00) @db.Decimal(10, 2)
  impostos_detalhes Json?  // Guarda % de alíquotas aplicadas, IBs, CBS e impostos complexos

  notas_fiscais   notas_fiscais @relation(fields: [id_nota], references: [id_nota], onDelete: Cascade, map: "fk_nfi_nota")
  produtos        produtos?     @relation(fields: [id_produto], references: [id_produto], onDelete: SetNull, map: "fk_nfi_produto")

  @@index([id_nota], map: "idx_nfi_nota")
  @@index([id_produto], map: "idx_nfi_produto")
}

model controle_modulos {
