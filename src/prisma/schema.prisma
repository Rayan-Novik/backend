  id_produto    Int      // O produto "Pai" (ex: Combo Burger)
  id_tenant     Int
  nome          String   @db.VarChar(100) // Ex: "Escolha sua bebida"
  minimo        Int      @default(0)
  maximo        Int      @default(1)
  ordem         Int      @default(0)
  tipo_grupo  String   @default("CHOICE")
  ifood_id      String?  @db.VarChar(255) // Para salvar o UUID do grupo gerado pelo iFood

  produtos      produtos @relation(fields: [id_produto], references: [id_produto], onDelete: Cascade)
  tenants       tenants  @relation(fields: [id_tenant], references: [id], onDelete: Cascade)
  complementos  produto_complementos[]

  @@index([id_produto])
  @@index([id_tenant])
}

model produto_complementos {
  id_complemento Int     @id @default(autoincrement())
  id_grupo       Int
  id_produto_add Int     // O produto que está sendo listado como opção (ex: Coca-Cola)
  preco_adicional Decimal @default(0.00) @db.Decimal(10, 2)
  ifood_id       String?  @db.VarChar(255) 
  minimo         Int      @default(0)
  maximo         Int      @default(1)

  grupo          produto_grupos_complemento @relation(fields: [id_grupo], references: [id_grupo], onDelete: Cascade)
  produto_add    produtos @relation(fields: [id_produto_add], references: [id_produto], onDelete: Cascade)

  @@index([id_grupo])
  @@index([id_produto_add])
