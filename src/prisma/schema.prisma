model WhatsappContatos {
  jid           String      @db.VarChar(255)
  id_tenant     Int
  nome          String?     @db.VarChar(255)
  pictureUrl    String?     @db.VarChar(1024)
  recado        String?     @db.VarChar(255)
  responsavelId Int?
  status        String      @default("pendentes") @db.VarChar(50)
  
  createdAt     DateTime    @default(now())
  
  mensagens     WhatsappMensagens[]
  agendamentos  Agendamento[]
  tenants       tenants     @relation(fields: [id_tenant], references: [id], onDelete: Cascade)

  @@id([jid, id_tenant])
  @@index([id_tenant], map: "idx_whats_contatos_tenant")
}

model WhatsappMensagens {
  id         Int      @id @default(autoincrement())
  id_tenant  Int
  whatsappId String   @db.VarChar(255) 
  remoteJid  String   @db.VarChar(255) 
  conteudo   String   @db.Text
  fromMe     Boolean  
  tipo       String   @default("text") @db.VarChar(50) 
  data_envio DateTime @default(now())
  lida       Boolean  @default(false)
  
  contato    WhatsappContatos @relation(fields: [remoteJid, id_tenant], references: [jid, id_tenant], onDelete: Cascade)
  tenants    tenants          @relation(fields: [id_tenant], references: [id], onDelete: Cascade)

  @@unique([whatsappId, id_tenant], map: "uk_whats_msg_id")
  @@index([remoteJid, id_tenant], map: "idx_whats_msg_contato")
  @@index([id_tenant], map: "idx_whats_msg_tenant")
}

model RespostasRapidas {
  id         Int      @id @default(autoincrement())
  id_tenant  Int
  atalho     String   @db.VarChar(50)
  mensagem   String   @db.Text
  criado_em  DateTime @default(now())

  tenant     tenants  @relation(fields: [id_tenant], references: [id], onDelete: Cascade)
  
  @@map("respostas_rapidas")
}

model agendamentos_servicos {
  id_agendamento Int      @id @default(autoincrement())
  id_tenant      Int
  id_usuario     Int      // Cliente que agendou
  id_funcionario Int?     // Profissional selecionado (opcional caso a loja distribua)
  id_loja        Int      // Local do serviço
  id_pedido      Int?     @unique // Vínculo 1:1 com o seu sistema de pagamentos atual
  data_inicio    DateTime @db.DateTime(0)
  data_fim       DateTime @db.DateTime(0)
  status         String   @default("PENDENTE") @db.VarChar(50) // PENDENTE, CONFIRMADO, CANCELADO, CONCLUIDO
  observacoes    String?  @db.Text
  criado_em      DateTime @default(now()) @db.Timestamp(0)

  // Relações
  tenants        tenants       @relation(fields: [id_tenant], references: [id], onDelete: Cascade)
  usuarios       usuarios      @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  funcionarios   funcionarios? @relation(fields: [id_funcionario], references: [id_funcionario], onDelete: SetNull)
  lojas          lojas         @relation(fields: [id_loja], references: [id_loja], onDelete: Cascade)
  pedidos        pedidos?      @relation(fields: [id_pedido], references: [id_pedido], onDelete: SetNull)

  @@index([id_tenant], map: "idx_agenda_serv_tenant")
  @@index([id_usuario], map: "idx_agenda_serv_usuario")
  @@index([id_funcionario], map: "idx_agenda_serv_func")
  @@index([id_loja], map: "idx_agenda_serv_loja")
  @@index([data_inicio, data_fim], map: "idx_agenda_serv_datas")
}

model Agendamento {
  id          Int      @id @default(autoincrement())
  id_tenant   Int
  titulo      String
  inicio      DateTime
  fim         DateTime
  observacoes String?  @db.Text
  clienteJid  String
  createdAt   DateTime @default(now())
  
  WhatsappContatos WhatsappContatos @relation(fields: [clienteJid, id_tenant], references: [jid, id_tenant], onDelete: Cascade)
  tenants          tenants          @relation(fields: [id_tenant], references: [id], onDelete: Cascade)

  @@index([clienteJid, id_tenant], map: "idx_agenda_contato")
  @@index([id_tenant], map: "idx_agenda_tenant")
}

