}

model fiscal_eventos {
  id                  String           @id @default(uuid())
  tenant_id           String

  nota_id             String
  tipo                TipoEventoFiscal
  sequencial          Int              @default(1)

  data_evento         DateTime         @default(now())
  protocolo_sefaz     String?
  payload_xml_envio   String?          @db.LongText
  payload_xml_retorno String?          @db.LongText
  justificativa       String?          @db.Text
  codigo_status_sefaz String?
  motivo_status_sefaz String?          @db.Text

  nota                fiscal_notas     @relation(fields: [nota_id], references: [id], onDelete: Cascade)

  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  @@map("fiscal_eventos")
  @@index([tenant_id])
}

model fiscal_inutilizacoes {
  id                  String           @id @default(uuid())
  tenant_id           String
  estabelecimento_id  String
  serie_id            String

  numero_inicial      Int
  numero_final        Int
  justificativa       String           @db.Text
  protocolo_sefaz     String?
  status              StatusNotaFiscal @default(RASCUNHO)
  codigo_status_sefaz String?
  motivo_status_sefaz String?          @db.Text

  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  @@map("fiscal_inutilizacoes")
  @@index([tenant_id])
}

model fiscal_nota_itens {
  id                String       @id @default(uuid())
  tenant_id         String
  nota_id           String

  numero_item       Int
  produto_id        String
  codigo_produto    String
  descricao_produto String
  cfop              String
  ncm               String
  cest              String?
  origem            Int

  quantidade        Decimal      @db.Decimal(10, 4)
  valor_unitario    Decimal      @db.Decimal(10, 4)
  valor_total       Decimal      @db.Decimal(10, 2)
  valor_desconto    Decimal      @db.Decimal(10, 2)
  valor_frete       Decimal      @db.Decimal(10, 2)
  valor_seguro      Decimal      @db.Decimal(10, 2)
  valor_outras      Decimal      @db.Decimal(10, 2)

  item_original_id  String?

  icms_cst_csosn    String
  icms_base         Decimal      @db.Decimal(10, 2)
  icms_aliquota     Decimal      @db.Decimal(5, 2)
  icms_valor        Decimal      @db.Decimal(10, 2)

  icms_st_base      Decimal?     @db.Decimal(10, 2)
  icms_st_aliquota  Decimal?     @db.Decimal(5, 2)
  icms_st_valor     Decimal?     @db.Decimal(10, 2)

  ipi_cst           String?
  ipi_base          Decimal?     @db.Decimal(10, 2)
  ipi_aliquota      Decimal?     @db.Decimal(5, 2)
  ipi_valor         Decimal?     @db.Decimal(10, 2)

  pis_cst           String?
  pis_base          Decimal?     @db.Decimal(10, 2)
  pis_aliquota      Decimal?     @db.Decimal(5, 2)
  pis_valor         Decimal?     @db.Decimal(10, 2)

  cofins_cst        String?
  cofins_base       Decimal?     @db.Decimal(10, 2)
  cofins_aliquota   Decimal?     @db.Decimal(5, 2)
  cofins_valor      Decimal?     @db.Decimal(10, 2)

  ibs_cst           String?
  ibs_base          Decimal?     @db.Decimal(10, 2)
  ibs_aliquota      Decimal?     @db.Decimal(5, 2)
  ibs_valor         Decimal?     @db.Decimal(10, 2)

  cbs_cst           String?
  cbs_base          Decimal?     @db.Decimal(10, 2)
  cbs_aliquota      Decimal?     @db.Decimal(5, 2)
  cbs_valor         Decimal?     @db.Decimal(10, 2)

  cClassTrib        String?

  nota              fiscal_notas @relation(fields: [nota_id], references: [id], onDelete: Cascade)

  @@map("fiscal_nota_itens")
  @@index([tenant_id])
}

enum TipoReferencia {
  DEVOLUCAO
  COMPLEMENTAR
  AJUSTE
  OUTROS
}

model fiscal_documentos_referenciados {
  id              String         @id @default(uuid())
  tenant_id       String
  nota_id         String
  chave_acesso    String
  tipo_referencia TipoReferencia @default(OUTROS)

  nota            fiscal_notas   @relation(fields: [nota_id], references: [id], onDelete: Cascade)

  @@map("fiscal_documentos_referenciados")
  @@index([tenant_id])
}

model fiscal_formas_pagamento {
  id           String         @id @default(uuid())
  tenant_id    String
  descricao    String
  codigo_sefaz String
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  notas        fiscal_notas[]

  @@map("fiscal_formas_pagamento")
  @@index([tenant_id])
}

model fiscal_api_tokens {
  id         String   @id @default(uuid())
  tenant_id  String
  token      String   @unique
  ambiente   Int      @default(2)
  nome       String
  ativo      Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("fiscal_api_tokens")
  @@index([tenant_id])
  @@index([token])
}

model fiscal_usuarios {
  id         String   @id @default(uuid())
  tenant_id  String?
  nome       String
  email      String   @unique
  senha      String
  role       String   @default("USER")
  ativo      Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("fiscal_usuarios")
}

model fiscal_webhooks {
  id                 String   @id @default(uuid())
  tenant_id          String
  estabelecimento_id String?
  url                String
  eventos            String
  secret             String?
  ativo              Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("fiscal_webhooks")
  @@index([tenant_id])
}

// ==========================================
// MÓDULO PDV (FRENTE DE CAIXA)
// ==========================================

model pdv_caixas {
  id                 String   @id @default(uuid())
  tenant_id          String
  estabelecimento_id String
  nome               String   // Ex: Caixa 01, Caixa Principal
  numero_caixa       Int      @default(1)
  serie_id           String?
  token_conexao      String?  @unique @db.VarChar(100)
  hardware_id        String?  @db.VarChar(255)
  ativo              Boolean  @default(true)

  turnos             pdv_turnos[]
  dispositivos       pdv_dispositivos[]
  estabelecimento    fiscal_estabelecimentos @relation(fields: [estabelecimento_id], references: [id], onDelete: Cascade)
  serie              fiscal_series?          @relation(fields: [serie_id], references: [id], onDelete: SetNull)

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([tenant_id, estabelecimento_id, nome])
  @@index([tenant_id])
  @@index([estabelecimento_id])
  @@index([serie_id])
  @@map("pdv_caixas")
}

model pdv_turnos {
  id                         String   @id @default(uuid())
  tenant_id                  String
  estabelecimento_id         String
  caixa_id                   String
  usuario_id                 String   // ID do Operador (fiscal_usuarios ou usuarios)
  status                     String   @default("ABERTO") // ABERTO, FECHADO

  data_abertura              DateTime @default(now())
  data_fechamento            DateTime?

  valor_abertura             Float    @default(0)
  valor_fechamento_esperado  Float?
  valor_fechamento_informado Float?

  observacoes                String?  @db.Text

  caixa                      pdv_caixas @relation(fields: [caixa_id], references: [id], onDelete: Cascade)

  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  @@index([tenant_id])
  @@index([caixa_id])
  @@map("pdv_turnos")
}

model pdv_dispositivos {
  id                 String   @id @default(uuid())
  tenant_id          String
  estabelecimento_id String
  caixa_id           String

  tipo               String   // IMPRESSORA, BALANCA, LEITOR
  nome               String   // Ex: EPSON TM-T20, Balança Toledo

  configuracao       String   @db.Text // JSON contendo portas COM, BaudRate, Tipo de Conexão, WebSerial, etc.
  ativo              Boolean  @default(true)

  caixa              pdv_caixas @relation(fields: [caixa_id], references: [id], onDelete: Cascade)

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([tenant_id])
  @@index([caixa_id])
  @@map("pdv_dispositivos")
}