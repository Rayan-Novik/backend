  faturas_saas           faturas_saas[]
  pedido_items           pedido_items[]
  pedidos                pedidos[]
  produto_visualizacoes  produto_visualizacoes[]
  produtos               produtos[]
  tenant_webhooks        tenant_webhooks[]
