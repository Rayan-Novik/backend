generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model carrinhos {
  id_carrinho     Int      @id @default(autoincrement())
  id_tenant       Int?
  id_usuario      Int
  id_produto      Int
  id_variacao     Int?
  quantidade      Decimal  @db.Decimal(10, 3)
  data_adicionado DateTime @default(now()) @db.Timestamp(0)
  complementos    Json?
  observacao      String?  @db.Text
  
  usuarios        usuarios @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "carrinhos_ibfk_1")
  produtos        produtos @relation(fields: [id_produto], references: [id_produto], onDelete: Cascade, onUpdate: NoAction, map: "carrinhos_ibfk_2")

  // 🟢 UNIQUE REMOVIDO! Adicionamos um Index normal no lugar para manter a performance da busca rápida
  @@index([id_usuario], map: "idx_usuario_carrinho")
  @@index([id_produto], map: "id_produto")
}

model enderecos {
  id_endereco  Int       @id @default(autoincrement())
  id_usuario   Int
  cep          String?   @db.VarChar(10)
  logradouro   String    @db.VarChar(255)
  numero       String    @db.VarChar(20)
  complemento  String?   @db.VarChar(100)
  bairro       String    @db.VarChar(100)
  cidade       String    @db.VarChar(100)
  estado       String    @db.VarChar(2)
  is_principal Boolean?  @default(false)
  is_active    Boolean   @default(true)
  latitude     Float?
  longitude    Float?
  usuarios     usuarios  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "enderecos_ibfk_1")
  pedidos      pedidos[]

  @@index([id_usuario], map: "id_usuario")
}

model pedido_items {
  id_item         Int      @id @default(autoincrement())
  id_pedido       Int
  id_produto      Int?
  id_variacao     Int?
  nome            String   @db.VarChar(255)
  quantidade      Decimal  @db.Decimal(10, 3)
  preco           Decimal  @db.Decimal(10, 2)
  imagem_url      String?  @db.VarChar(2048)
  id_tenant       Int      @default(1)
  nome_atendente  String?  @db.VarChar(255)
  observacao      String?  @db.Text
  complementos    Json?

  // 🟢 CAMPOS EXCLUSIVOS PARA SINCRONIZAÇÃO HÍBRIDA
  sync_id                String?   @unique @default(uuid()) @db.VarChar(36)
  sincronizado_cloud    Boolean   @default(false)
  atualizado_em         DateTime  @default(now()) @updatedAt
  deletado_em           DateTime?

  tenants tenants @relation(fields: [id_tenant], references: [id], onDelete: Cascade, map: "fk_pedido_items_tenant")
  pedidos pedidos @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade, onUpdate: NoAction, map: "pedido_items_fk_pedido")

  @@index([id_pedido], map: "id_pedido")
  @@index([id_tenant], map: "fk_pedido_items_tenant")
  @@index([sincronizado_cloud], map: "idx_sync_pedido_items")
}

model pedidos {
  id_pedido             Int      @id @default(autoincrement())
  id_tenant             Int
  id_usuario            Int
  id_endereco_entrega   Int?
  entrega_cep           String?  @db.VarChar(10)
  entrega_logradouro    String?  @db.VarChar(255)
  entrega_numero        String?  @db.VarChar(20)
  entrega_complemento   String?  @db.VarChar(100)
  entrega_bairro        String?  @db.VarChar(100)
  entrega_cidade        String?  @db.VarChar(100)
  entrega_estado        String?  @db.VarChar(50)
  metodo_pagamento      String   @db.VarChar(50)
  preco_itens           Decimal  @db.Decimal(10, 2)
  preco_frete           Decimal  @db.Decimal(10, 2)
  preco_total           Decimal  @db.Decimal(10, 2)
  status_pagamento      String?  @default("PENDENTE") @db.VarChar(50)
  id_pagamento_gateway  String?  @db.VarChar(255)
  data_pedido           DateTime @default(now()) @db.Timestamp(0)
  status_entrega        String   @default("Pendente") @db.VarChar(50)
  metodo_envio          String?  @db.VarChar(100)
  prazo_entrega         String?  @db.VarChar(50)
  codigo_rastreio       String?  @db.VarChar(255)
  id_cupom_utilizado    Int?
  canal_venda           String   @default("ecommerce") @db.VarChar(50)
  gateway_provider      String   @default("MERCADOPAGO") @db.VarChar(50)
  ifood_order_id        String?  @unique(map: "ifood_order_id") @db.VarChar(255)
  ifood_display_id      String?  @db.VarChar(50)
  id_caixa_pdv          Int?
  url_boleto            String?  @db.Text
  linha_digitavel       String?  @db.VarChar(255)
  delivery_pin          String?  @db.VarChar(10)
  driver_token          String?  @unique @db.VarChar(255)
  driver_token_expires  DateTime? @db.DateTime(0)
  driver_lat            Float?
  driver_lng            Float?
  id_mesa               Int?
  codigo_comanda        String?  @db.VarChar(50)
  status_comanda        String?  @default("ABERTA") @db.VarChar(20)
  nome_cliente_comanda  String?  @db.VarChar(100)
  nome_atendente        String?  @db.VarChar(255)

  // 🟢 CAMPOS EXCLUSIVOS PARA SINCRONIZAÇÃO HÍBRIDA (Seguros para banco em produção)
  sync_id                String?   @unique @default(uuid()) @db.VarChar(36)
  origem_criacao        String    @default("LOCAL") @db.VarChar(20)
  sincronizado_cloud    Boolean   @default(false)
  atualizado_em         DateTime  @default(now()) @updatedAt
  deletado_em           DateTime?

  nota_fiscal               notas_fiscais?
  mesas                     mesas? @relation(fields: [id_mesa], references: [id_mesa], onDelete: SetNull)
  financeiro_contas_receber financeiro_contas_receber[]
  agendamento_servico       agendamentos_servicos?
  pedido_items              pedido_items[]
  caixa_pdv                 caixa_pdv? @relation(fields: [id_caixa_pdv], references: [id_caixa], map: "fk_pedidos_caixa_pdv")
  cupons_desconto           cupons_desconto? @relation(fields: [id_cupom_utilizado], references: [id_cupom], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedidos_cupom")
  tenants                   tenants @relation(fields: [id_tenant], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pedidos_tenants")
  enderecos                 enderecos? @relation(fields: [id_endereco_entrega], references: [id_endereco], onDelete: NoAction, onUpdate: NoAction, map: "pedidos_fk_endereco")
  usuarios                  usuarios @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "pedidos_fk_usuario")
  transacoes_financeiras    transacoes_financeiras[]

  @@index([id_endereco_entrega], map: "id_endereco_entrega")
  @@index([id_usuario], map: "id_usuario")
  @@index([id_cupom_utilizado], map: "fk_pedidos_cupom")
  @@index([id_caixa_pdv], map: "idx_pedidos_caixa_pdv")
  @@index([id_tenant], map: "fk_pedidos_tenants")
  @@index([sincronizado_cloud], map: "idx_sync_pedidos")
}

model impressoras {
  id_impressora Int      @id @default(autoincrement())
  id_tenant     Int
  nome          String   @db.VarChar(100) // Ex: "Cozinha Quente", "Bar", "Caixa"
  tipo_conexao  String   @default("REDE") @db.VarChar(50) // REDE, USB, BLUETOOTH
  endereco_ip   String?  @db.VarChar(50)  // Ex: "192.168.1.110"
  largura_papel Int      @default(80)     // 80mm ou 58mm
  is_padrao     Boolean  @default(false)  // Se true, recebe tudo que não tiver categoria
  ativo         Boolean  @default(true)

  categorias    categorias[] // Relacionamento: Quais categorias imprimem aqui
}

model mesas {
  id_mesa       Int      @id @default(autoincrement())
  id_tenant     Int
  nome          String   @db.VarChar(50)
  status        String   @default("LIVRE") @db.VarChar(20)
  token         String?  @unique @db.VarChar(100) 
  url_qrcode    String?  @db.VarChar(2048)
  mesa_agrupada String?  @db.VarChar(50)
  
  // 🟢 CAMPOS EXCLUSIVOS PARA SINCRONIZAÇÃO HÍBRIDA
  sync_id                String?   @unique @default(uuid()) @db.VarChar(36)
  sincronizado_cloud    Boolean   @default(false)
  atualizado_em         DateTime  @default(now()) @updatedAt
  deletado_em           DateTime?

  tenants tenants @relation(fields: [id_tenant], references: [id], onDelete: Cascade)
  pedidos pedidos[]

  @@index([id_tenant], map: "idx_mesas_tenant")
  @@index([sincronizado_cloud], map: "idx_sync_mesas")
}

model produtos {
  id_produto                  Int                           @id @default(autoincrement())
  id_tenant                   Int
  id_fiscal                   String?       @unique @db.VarChar(36)
  nome                        String                        @db.VarChar(255)
  slug                        String?                       @unique @db.VarChar(255)
  descricao                   String?                       @db.Text
  preco                       Decimal                       @db.Decimal(10, 2)
  estoque                     Decimal                       @default(0.000) @db.Decimal(10, 3)
  imagem_url                  String?                       @db.VarChar(2048)
  id_categoria                Int?
  id_marca                    Int?
  desconto_percentual         Int                           @default(0)
  visualizacoes               Int                           @default(0)
  id_fornecedor               Int?
  url_shopee_original         String?                       @db.VarChar(2048)
  peso                        Decimal                       @default(0.30) @db.Decimal(10, 2)
  comprimento                 Decimal                       @default(16.00) @db.Decimal(10, 2)
  altura                      Decimal                       @default(2.00) @db.Decimal(10, 2)
  largura                     Decimal                       @default(11.00) @db.Decimal(10, 2)
  mercado_livre_id            String?                       @db.VarChar(255)
  ml_status                   String?                       @default("Não Publicado") @db.VarChar(50)
  tiktok_video_url            String?                       @db.VarChar(2048)
  tiktok_product_id           String?                       @db.VarChar(255)
  tiktok_status               String?                       @default("Não Publicado") @db.VarChar(50)
  custo                       Decimal?                      @db.Decimal(10, 2)
  ativo                       Boolean                       @default(true)
  ml_category_id              String?                       @db.VarChar(255)
  ml_attributes               Json?
  id_subcategoria             Int?
  active_ecommerce            Boolean                       @default(true)
  id_externo                  String?                       @unique(map: "uk_produtos_id_externo") @db.VarChar(255)
  preco_custo                 Decimal                       @default(0.00) @db.Decimal(10, 2)
  ifood_id                    String?                       @unique(map: "ifood_id") @db.VarChar(255)
  ifood_status                String?                       @default("AVAILABLE") @db.VarChar(50)
  preco_ifood                 Decimal?                      @db.Decimal(10, 2)
  ifood_serving               String?                       @default("NOT_APPLICABLE") @db.VarChar(50)
  ifood_restricoes            String?                       @db.VarChar(255) 
  tempo_duracao               Int?                          @default(60)
  unidade                     produtos_unidade              @default(UN)
  tipo_produto                produtos_tipo_produto         @default(FINAL)
  estoque_minimo              Decimal?                      @default(0.000) @db.Decimal(10, 3)

  // 🟢 DADOS FISCAIS DO PRODUTO (TRIBUTAÇÃO E REFORMA TRIBUTÁRIA)
  origem                      String?                       @default("0") @db.VarChar(1) // 0-Nacional, 1-Estrangeira, etc.
  ncm                         String?                       @db.VarChar(10)
  cest                        String?                       @db.VarChar(10)
  cfop_padrao                 String?                       @db.VarChar(5)
  cst_icms                    String?                       @db.VarChar(4) // CSOSN para Simples ou CST para Normal
  cst_pis_cofins              String?                       @db.VarChar(4)
  cst_ipi                     String?                       @db.VarChar(4)
  aliq_icms                   Decimal?                      @default(0.00) @db.Decimal(5, 2)
  aliq_pis                    Decimal?                      @default(0.00) @db.Decimal(5, 2)
  aliq_cofins                 Decimal?                      @default(0.00) @db.Decimal(5, 2)
  aliq_iss                    Decimal?                      @default(0.00) @db.Decimal(5, 2) // Usado se for serviço
  aliq_ipi                    Decimal?                      @default(0.00) @db.Decimal(5, 2)
  cClassTrib                  String?                       @db.VarChar(20)
  aliq_ibs                    Decimal?                      @default(0.00) @db.Decimal(5, 2) // Reforma Tributária
  aliq_cbs                    Decimal?                      @default(0.00) @db.Decimal(5, 2) // Reforma Tributária
  

  // 🟢 CAMPOS EXCLUSIVOS PARA SINCRONIZAÇÃO HÍBRIDA
  sync_id                String?   @unique @default(uuid()) @db.VarChar(36)
  sincronizado_cloud     Boolean   @default(false)
  atualizado_em          DateTime  @default(now()) @updatedAt
  deletado_em            DateTime?

  // RELACIONAMENTOS
  AuditoriaProduto            AuditoriaProduto[]
  MovimentacaoEstoque         MovimentacaoEstoque[]
  avaliacoes                  avaliacoes[]
  campanha_marketing_produtos campanha_marketing_produtos[]
  carrinhos                   carrinhos[]
  cupons_desconto             cupons_desconto[]
  historico_precos            historico_precos[]
  lista_desejos               lista_desejos[]
  log_estoque                 log_estoque[]
  ordens_producao             ordens_producao[]
  composicao_filho            produto_composicao[]          @relation("RelacaoInsumo")
  composicao_pai              produto_composicao[]          @relation("RelacaoProdutoFinal")
  produto_subimagens          produto_subimagens[]
  produto_visualizacoes       produto_visualizacoes[]
  fornecedores                fornecedores?                 @relation(fields: [id_fornecedor], references: [id_fornecedor], map: "fk_produtos_fornecedor")
  tenants                     tenants                       @relation(fields: [id_tenant], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_produtos_tenants")
  categorias                  categorias?                   @relation(fields: [id_categoria], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction, map: "produtos_ibfk_1")
  marcas                      marcas?                       @relation(fields: [id_marca], references: [id_marca], onDelete: NoAction, onUpdate: NoAction, map: "produtos_ibfk_2")
  subcategorias               subcategorias?                @relation(fields: [id_subcategoria], references: [id_subcategoria], onDelete: NoAction, onUpdate: NoAction, map: "produtos_ibfk_subcategoria")
  promocoes_automaticas       promocoes_automaticas[]
  grupos_complemento          produto_grupos_complemento[]
  complementos_como_opcao     produto_complementos[]
  produto_variacoes           produto_variacoes[]
  nota_fiscal_itens           nota_fiscal_itens[]

  @@index([id_categoria], map: "id_categoria")
  @@index([id_marca], map: "id_marca")
  @@index([id_subcategoria], map: "id_subcategoria")
  @@index([id_fornecedor], map: "idx_produto_fornecedor")
  @@index([id_tenant], map: "fk_produtos_tenants")
  @@index([sincronizado_cloud], map: "idx_sync_produtos")
}

model produto_variacoes {
  id_variacao    Int      @id @default(autoincrement())
  id_produto     Int
  id_tenant      Int
  sku            String?  @db.VarChar(100)  // Código único da variação (ex: CAM-VER-M)
  cor            String?  @db.VarChar(50)   // Ex: Verde, Vermelho
  tamanho        String?  @db.VarChar(50)   // Ex: P, M, GG, 38, 40
  estoque        Decimal  @default(0.000) @db.Decimal(10, 3)
  preco_adicional Decimal @default(0.00) @db.Decimal(10, 2) // Se a GG for R$ 5 mais cara
  imagem_url     String?  @db.VarChar(2048) // Foto específica da camisa vermelha (opcional)
  ativo          Boolean  @default(true)

  // 🟢 CAMPOS EXCLUSIVOS PARA SINCRONIZAÇÃO HÍBRIDA
  sync_id                String?   @unique @default(uuid()) @db.VarChar(36)
  sincronizado_cloud     Boolean   @default(false)
  atualizado_em          DateTime  @default(now()) @updatedAt
  deletado_em            DateTime?

  produtos       produtos @relation(fields: [id_produto], references: [id_produto], onDelete: Cascade, map: "fk_variacao_produto")
  tenants        tenants  @relation(fields: [id_tenant], references: [id], onDelete: Cascade, map: "fk_variacao_tenant")

  @@index([id_produto], map: "idx_variacoes_produto")
  @@index([id_tenant], map: "idx_variacoes_tenant")
  @@index([sincronizado_cloud], map: "idx_sync_variacoes")
}

model usuarios {
  id_usuario                    Int       @id @default(autoincrement())
  id_tenant                     Int
  nome_completo                 String    @db.VarChar(255)
  email                         String    @db.VarChar(255)
  hash_senha                    String    @db.VarChar(255)
  endereco_criptografado        String?   @db.Text
  telefone_criptografado        String?   @db.Text
  cpf_criptografado             String?   @db.Text
  data_nascimento_criptografada String?   @db.Text
  data_criacao                  DateTime  @default(now()) @db.Timestamp(0)
  reset_password_token          String?   @unique(map: "reset_password_token") @db.VarChar(255)
  reset_password_expires        DateTime? @db.DateTime(0)
  criado_em                     DateTime? @default(now()) @db.DateTime(0)
  score_reputacao               Int?      @default(50)
  total_pedidos_pagos           Int?      @default(0)
  is_verified                   Boolean?  @default(false)

  // --- RELAÇÕES EXCLUSIVAS DE CLIENTES ---
  avaliacoes                  avaliacoes[]
  carrinhos                   carrinhos[]
  enderecos                   enderecos[]
  financeiro_contas_receber   financeiro_contas_receber[]
  lista_desejos               lista_desejos[]
  pedidos                     pedidos[]
  agendamentos_servicos agendamentos_servicos[]
  transacoes_financeiras      transacoes_financeiras[]
  tenants                     tenants   @relation(fields: [id_tenant], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuarios_tenants")

  @@unique([email, id_tenant], map: "uk_email_tenant")
  @@index([id_tenant], map: "fk_usuarios_tenants")
}

model funcionarios {
  id_funcionario         Int       @id @default(autoincrement())
  id_tenant              Int
  nome_completo          String    @db.VarChar(255)
  email                  String    @db.VarChar(255)
  hash_senha             String    @db.VarChar(255)
  sessao_token           String?   @db.VarChar(255)
  cpf_criptografado      String?   @db.Text
  telefone_criptografado String?   @db.Text
  role                   String    @default("ATENDENTE") @db.VarChar(50)
  isAdmin                Boolean   @default(false)
  codigo_acesso          String?   @unique(map: "codigo_acesso_func_unique") @db.VarChar(20)
  ativo                  Boolean   @default(true)
  criado_em              DateTime? @default(now()) @db.DateTime(0)

  // 🟢 NOVOS CAMPOS PARA O PERFIL DO PROFISSIONAL (IMAGEM E TEXTOS)
  imagem                 String?   @db.VarChar(512) // Guarda a URL da imagem
  especialidade          String?   @db.VarChar(255)
  bio                    String?   @db.Text
  formacao               Json?     // Salva como array JSON: ["Graduação...", "Especialização..."]
  atuacao                Json?     // Salva como array JSON: ["Ansiedade...", "Tratamento..."]
  sobre                  Json?     // Salva como array JSON: ["Simone Vieira da Silva...", "Sua abordagem..."]

  // 🟢 CAMPOS EXCLUSIVOS PARA SINCRONIZAÇÃO HÍBRIDA
  sync_id                String?   @unique @default(uuid()) @db.VarChar(36)
  sincronizado_cloud     Boolean   @default(false)
  atualizado_em          DateTime  @default(now()) @updatedAt
  deletado_em            DateTime?

  // Relação com a tabela de cargos personalizados
  id_cargo               Int?      
  cargos                 cargos?   @relation(fields: [id_cargo], references: [id_cargo], onDelete: SetNull)

  // --- RELAÇÕES DE TRABALHO E GESTÃO ---
  tenants                tenants   @relation(fields: [id_tenant], references: [id], onDelete: Cascade, map: "fk_funcionarios_tenants")
  caixa_pdv              caixa_pdv[]
  AuditoriaProduto       AuditoriaProduto[]
  log_estoque            log_estoque[]
  ordens_producao        ordens_producao[]
  MovimentacaoEstoque    MovimentacaoEstoque[]
  financeiro_baixas      financeiro_baixas[]
  financeiro_contas_pagar financeiro_contas_pagar[]
  agendamentos_servicos  agendamentos_servicos[]
  
  @@unique([email, id_tenant], map: "uk_email_tenant_func")
  @@index([id_tenant], map: "fk_funcionarios_tenants_idx")
  @@index([id_cargo], map: "idx_funcionarios_cargo")
  @@index([sincronizado_cloud], map: "idx_sync_funcionarios")
}

model cargos {
  id_cargo     Int          @id @default(autoincrement())
  id_tenant    Int
  nome         String       @db.VarChar(100)
  descricao    String?      @db.VarChar(255)
  permissoes   Json            
  
  // A TRAVA MESTRA: Garante que o cargo do Dono não seja apagado nem modificado
  is_dono      Boolean      @default(false)
  
  ativo        Boolean      @default(true)
  criado_em    DateTime     @default(now()) @db.Timestamp(0)

  // 🟢 CAMPOS EXCLUSIVOS PARA SINCRONIZAÇÃO HÍBRIDA
  sync_id                String?   @unique @default(uuid()) @db.VarChar(36)
  sincronizado_cloud     Boolean   @default(false)
  atualizado_em          DateTime  @default(now()) @updatedAt
  deletado_em            DateTime?
  
  tenants      tenants      @relation(fields: [id_tenant], references: [id], onDelete: Cascade)
  funcionarios funcionarios[]

  @@unique([nome, id_tenant], map: "uk_cargo_nome_tenant")
  @@index([id_tenant], map: "idx_cargos_tenant")
  @@index([sincronizado_cloud], map: "idx_sync_cargos")
}

model categorias {
  id_categoria          Int                     @id @default(autoincrement())
  id_tenant             Int
  nome                  String                  @unique(map: "nome") @db.VarChar(255)
  ifood_id              String?                 @unique(map: "ifood_id_cat") @db.VarChar(255) // 🟢 ADICIONADO PARA O IFOOD
  cupons_desconto       cupons_desconto[]
  produtos              produtos[]
  promocoes_automaticas promocoes_automaticas[]
  subcategorias         subcategorias[]
  id_impressora Int? // ID da impressora que vai receber esses itens
  impressora    impressoras? @relation(fields: [id_impressora], references: [id_impressora], onDelete: SetNull)
}

model carrossel_slides {
  id_slide   Int     @id @default(autoincrement())
  id_tenant  Int?
  imagem_url String  @db.VarChar(2048)
  link_url   String  @db.VarChar(2048)
  titulo     String? @db.VarChar(255)
  subtitulo  String? @db.VarChar(255)
  ativo      Boolean @default(true)
  ordem      Int?    @default(0)
}

model destaques_categorias {
  id_destaque Int     @id @default(autoincrement())
  id_tenant   Int?
  imagem_url  String  @db.VarChar(2048)
