  id_loja               Int?
  descricao             String                           @db.VarChar(255)
  valor_total           Decimal                          @db.Decimal(10, 2)
  valor_recebido        Decimal                          @default(0.00) @db.Decimal(10, 2)
  saldo_restante        Decimal                          @db.Decimal(10, 2)
  data_competencia      DateTime                         @db.Date
  data_vencimento       DateTime                         @db.Date
  data_liquidacao       DateTime?
  status                financeiro_contas_receber_status @default(PENDENTE)
  id_usuario            Int?
  id_pedido             Int?
  id_categoria          Int?
  parcela_numero        Int?                             @default(1)
  parcela_total         Int?                             @default(1)
  criado_em             DateTime                         @default(now())
  atualizado_em         DateTime                         @updatedAt
  financeiro_baixas     financeiro_baixas[]
  financeiro_categorias financeiro_categorias?           @relation(fields: [id_categoria], references: [id], map: "fk_fcr_categoria")
  pedidos               pedidos?                         @relation(fields: [id_pedido], references: [id_pedido], map: "fk_fcr_pedido")
  usuarios              usuarios?                        @relation(fields: [id_usuario], references: [id_usuario], map: "fk_fcr_usuario")

  @@index([id_categoria], map: "fk_fcr_categoria")
  @@index([id_pedido], map: "idx_fcr_pedido")
  @@index([status], map: "idx_fcr_status")
  @@index([data_vencimento], map: "idx_fcr_vencimento")
  @@index([id_usuario], map: "fk_fcr_usuario")
}

model ordens_producao {
