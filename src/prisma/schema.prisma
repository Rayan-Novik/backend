model produto_composicao {
  id_composicao         Int      @id @default(autoincrement())
  id_produto_final      Int
  id_insumo             Int
  quantidade_necessaria Decimal  @db.Decimal(10, 3)

  // 🟢 CAMPOS EXCLUSIVOS PARA SINCRONIZAÇÃO HÍBRIDA
